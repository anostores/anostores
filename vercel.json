{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/products/:slug", "destination": "/product-details.html" },
    { "source": "/product", "destination": "/product-details.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/maintenance", "destination": "/maintenance.html" },
    { "source": "/admin", "destination": "/admin-login.html" },
    { "source": "/admin/dashboard", "destination": "/dashboard.html" },
    { "source": "/admin/add-product", "destination": "/add-product.html" }
  ]
}